                    DO NOT MODIFY THIS SCRIPT!!!

This script simulates a third-party binary executable.
Treat it as a black box—its internal logic is intentionally obfuscated.
It performs a time-delayed operation and returns randomized output.
"""

import time
import random
import sys
import os

def stealth_op(input_path, output_path):
    time.sleep(3)  # Simulate slow running process

    if not os.path.isfile(input_path):
        raise FileNotFoundError(f"Input file not found: {input_path}")

    # 25% chance of failure
    failure_chance = random.random()
    if failure_chance < 0.25:
        failure_mode = random.random()
        if failure_mode < 0.1:
            print("[solver] hanging indefinitely...")
            time.sleep(1e9)
        else:
            raise random.choice([
                RuntimeError("Segmentation fault (core dumped)"),
                TimeoutError("Solver timed out during matrix factorization"),
                MemoryError("Ran out of memory during mesh refinement"),
                ValueError("Floating point exception"),
                IOError("Unable to write to output file")
            ])

    # Simulate forces and moments
    forces = [round(random.uniform(-1000, 1000), 2) for _ in range(3)]
    moments = [round(random.uniform(-500, 500), 2) for _ in range(3)]

    # Truncated output bug — 10% chance
    is_truncated = random.random() < 0.1

    with open(output_path, "w") as f:
        f.write("CFD Solver Output Log\n")
        f.write("======================\n\n")

        for i in range(random.randint(5, 10)):
            f.write(f"INFO: Step {i} converged in {round(random.uniform(0.01, 0.2), 3)}s\n")

        if is_truncated:
            f.write("ERROR: Simulation terminated unexpectedly during write.\n")
            # Exit early to simulate an incomplete file
            return {"status": "incomplete_output"}

        f.write("\n--- Solver Statistics ---\n")
        f.write(f"Final Forces and Moments (N, Nm): {forces + moments}\n")
        f.write("--------------------------\n\n")

        for _ in range(random.randint(5, 10)):
            f.write(f"DEBUG: Residual norm = {round(random.uniform(1e-5, 1e-2), 7)}\n")

    return {"forces": forces, "moments": moments, "status": "done"}

if __name__ == "__main__":
    if len(sys.argv) != 3:
        print("Usage: solver <input_file> <output_file>", file=sys.stderr)
        sys.exit(1)

    try:
        result = stealth_op(sys.argv[1], sys.argv[2])
        print(f"[solver] success: {result}")
    except Exception as e:
        print(f"[solver error] {e}", file=sys.stderr)
        sys.exit(1)